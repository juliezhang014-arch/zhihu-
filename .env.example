# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISABLE_HMR: Set to true to disable Vite HMR (hot module replacement / full-page
# auto reloads). AI Studio injects this at runtime to prevent the page from
# flickering while agents edit files. For local development keep it true as well:
# refresh the page manually after code changes, so an open page (e.g. mid-typing
# in the admin login dialog) is never disrupted by a hot reload.
DISABLE_HMR=true
